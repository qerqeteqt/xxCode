# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。

# DeepSeek API Key
LLM_API_KEY=sk-your-key-here

# OpenAI 兼容接口地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# 每轮对话后自动提取长期记忆（true / false）
EXTRACT_MEMORY=true

# Tavily 联网搜索的 key（https://tavily.com）。
# 留空就不注册 WebSearch 工具 —— 没有 key 就是没有这个能力
TAVILY_API_KEY=

# Main Agent 的最大步数。它是「防打转的兜底」，不是预算 ——
# 成本看会话列表里的 token 统计。
# 注意：只管 Main Agent。Explore/Plan(8)、General-Purpose(12)、
# AutoDream(12)、记忆提取器(6) 各有独立预算，改这里不影响它们。
MAX_STEPS=60

# 记忆整理（AutoDream）触发条件，两个是并且关系 —— 都满足才自动整理。
# 开发时想立刻跑一次，用 python main.py --consolidate
CONSOLIDATE_MIN_HOURS=24
CONSOLIDATE_MIN_SESSIONS=5

# 上下文压缩的触发阈值（上一次调用真实的 prompt token 数）。
# deepseek-chat 上限 64k，默认 40k 留出余量
COMPACT_THRESHOLD_TOKENS=40000
