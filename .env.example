# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。

# DeepSeek API Key
LLM_API_KEY=sk-your-key-here

# OpenAI 兼容接口地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# ReAct 循环的最大步数
MAX_STEPS=20

# 记忆整理（AutoDream）触发条件，两个是并且关系 —— 都满足才自动整理。
# 开发时想立刻跑一次，用 python main.py --consolidate
CONSOLIDATE_MIN_HOURS=24
CONSOLIDATE_MIN_SESSIONS=5

# 上下文压缩的触发阈值（上一次调用真实的 prompt token 数）。
# deepseek-chat 上限 64k，默认 40k 留出余量
COMPACT_THRESHOLD_TOKENS=40000
